IDI_ICON1 ICON DISCARDABLE "ATE_rst.ico"

#if defined(UNDER_CE)
#include <winbase.h>
#else
#include <winver.h>
#endif

// 2026-11-22 版本号改由 TreeATE 的单一版本源头文件生成
#include "../TreeATE/version.h"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION TREEATE_VERSION_MAJOR,TREEATE_VERSION_MINOR,TREEATE_VERSION_PATCH,0
    PRODUCTVERSION TREEATE_VERSION_MAJOR,TREEATE_VERSION_MINOR,TREEATE_VERSION_PATCH,0
    FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
    FILEFLAGS VS_FF_DEBUG
#else
    FILEFLAGS 0x0L
#endif
    FILEOS VOS_NT_WINDOWS32
    FILETYPE VFT_DLL
    FILESUBTYPE 0x0L
    BEGIN
        BLOCK "StringFileInfo"
        BEGIN
            BLOCK "080404b0"
            BEGIN
                VALUE "CompanyName", "David Yin\0"
                VALUE "FileDescription", "Test Results View for TreeATE\0"
                VALUE "FileVersion", TREEATE_VERSION_STR
                VALUE "ProductVersion", TREEATE_VERSION_STR
                VALUE "LegalCopyright", "Copyright 2026(C) David Yin\0"
                VALUE "LegalTrademarks", "TreeATE\0"
                VALUE "OriginalFilename", "TreeResults.exe\0"
                VALUE "ProductName", "TreeATE\0"
                VALUE "InternalName", "TreeResults.exe\0"
           END
        END
        
        BLOCK "VarFileInfo"
        BEGIN
            VALUE "Translation", 0x804, 1200
        END        
    END
