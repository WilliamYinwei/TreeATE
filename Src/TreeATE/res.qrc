<RCC>
    <qresource prefix="/">
        <file>code.png</file>
        <file>loading.png</file>
        <file>modify.png</file>
        <file>ng.png</file>
        <file>ok.png</file>
        <file>pause.png</file>
        <file>exce.png</file>
        <file>ATE.ico</file>
        <file>running.gif</file>
        <file>login.jpg</file>
        <file>add.png</file>
        <file>minus.png</file>
        <file>play.png</file>
    </qresource>
    <qresource prefix="/Qss">
        <file>blue.qss</file>
    </qresource>
    <qresource prefix="/Themes">
        <file alias="classic.qss">Themes/classic.qss</file>
        <file alias="light.qss">Themes/light.qss</file>
        <file alias="dark.qss">Themes/dark.qss</file>
        <file alias="theme.json">Themes/theme.json</file>
    </qresource>
    <qresource prefix="/i18n">
        <file alias="languages.json">i18n/languages.json</file>
    </qresource>
</RCC>
